GOOSE_DBSTRING=./atom1c.db

# Optional SSH settings (defaults: 127.0.0.1:23234 and the current account's
# ~/.ssh/authorized_keys and ~/.local/share/atom1c/ssh_host_ed25519_key).
# ATOM1C_SSH_ADDR=127.0.0.1:23234
# ATOM1C_AUTHORIZED_KEYS=/home/you/.ssh/authorized_keys
# ATOM1C_SSH_HOST_KEY=/home/you/.local/share/atom1c/ssh_host_ed25519_key

# Automatic refresh runs at startup and every 15 minutes after each sweep.
# Set to 0 to disable scheduled refresh while keeping manual refresh available.
# ATOM1C_REFRESH_INTERVAL=15m
